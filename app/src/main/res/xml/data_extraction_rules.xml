<?xml version="1.0" encoding="utf-8"?>
<!--
   Everything is backed up and transferred except the sync settings: they hold the passphrase and
   this installation's id, which must not be shared by a second phone restored from a backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sync.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sync.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
