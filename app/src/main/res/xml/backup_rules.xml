<?xml version="1.0" encoding="utf-8"?>
<!--
   For devices older than API 31 (newer ones use data_extraction_rules.xml): everything is backed
   up except the sync settings, which hold the passphrase and this installation's id.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/sync.preferences_pb" />
</full-backup-content>
